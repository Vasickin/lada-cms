{
  /*
   * PWA MANIFEST - МАНИФЕСТ ВЕБ-ПРИЛОЖЕНИЯ
   * ========================================================
   * Этот файл определяет поведение Progressive Web App (PWA)
   * при добавлении сайта на главный экран мобильного устройства.
   * Без этого файла браузеры не смогут правильно установить приложение.
   *
   * Официальная спецификация: https://www.w3.org/TR/appmanifest/
   * ========================================================
   */

  /*
   * 1. ОСНОВНАЯ ИНФОРМАЦИЯ О ПРИЛОЖЕНИИ
   * ========================================================
   */

  "name": "Общественная организация Лада",
  /*
   * Полное название приложения, которое будет отображаться:
   * - Под иконкой на главном экране
   * - В списке установленных приложений
   * - В настройках устройства
   */

  "short_name": "ЛАДА",
  /*
   * Короткое название (до 12 символов рекомендуется):
   * - Используется когда мало места (панель уведомлений и т.д.)
   * - Должно быть уникальным и узнаваемым
   */

  "description": "Общественная организация Лада - развитие гражданского общества и поддержка социальных инициатив",
  /*
   * Описание приложения:
   * - Отображается в магазинах приложений (Google Play, RuStore)
   * - Помогает пользователям понять назначение приложения
   * - Важно для SEO и discoverability
   */

  /*
   * 2. НАСТРОЙКИ ОТОБРАЖЕНИЯ И ЗАПУСКА
   * ========================================================
   */

  "start_url": "/",
  /*
   * URL, который открывается при запуске приложения:
   * - "/" - главная страница
   * - Можно указать "/?utm_source=pwa" для аналитики
   * - Должен быть относительным путем от корня сайта
   */

  "display": "standalone",
  /*
   * Режим отображения приложения:
   *
   * "standalone" - как нативное приложение (рекомендуется)
   *   - Скрывает адресную строку браузера
   *   - Скрывает элементы управления браузером
   *   - Выглядит как обычное приложение
   *
   * "fullscreen" - полноэкранный режим
   *   - Скрывает ВСЕ элементы интерфейса
   *   - Подходит для игр и immersive-опыта
   *
   * "minimal-ui" - минимальный интерфейс браузера
   *   - Показывает только основные элементы управления
   *
   * "browser" - как обычная веб-страница
   */

  "orientation": "portrait",
  /*
   * Ориентация экрана по умолчанию:
   *
   * "portrait" - портретная (вертикальная) - для большинства сайтов
   * "landscape" - альбомная (горизонтальная) - для игр, видео
   * "any" - любая ориентация
   * "natural" - ориентация по умолчанию устройства
   *
   * Можно указать несколько через пробел: "portrait landscape"
   */

  "scope": "/",
  /*
   * Область действия PWA:
   * - "/" - весь сайт
   * - "/projects/" - только раздел проектов
   *
   * Если пользователь перейдет за пределы scope,
   * приложение откроется в обычном браузере.
   */

  /*
   * 3. ВНЕШНИЙ ВИД И ДИЗАЙН
   * ========================================================
   */

  "background_color": "#ffffff",
  /*
   * Цвет фона при запуске приложения:
   * - Виден во время загрузки страницы
   * - Должен соответствовать цвету фона сайта
   * - Использует HEX формат (#RRGGBB)
   * - Без прозрачности (нельзя использовать rgba)
   */

  "theme_color": "#1d4ed8",
  /*
   * Основной цвет темы приложения:
   * - Цвет адресной строки в браузере
   * - Цвет панели состояния на Android
   * - Цвет заголовка окна на некоторых платформах
   * - Должен соответствовать бренд-цвету (primary-color из CSS)
   */

  /*
   * 4. ИКОНКИ ПРИЛОЖЕНИЯ
   * ========================================================
   * Каждая платформа требует иконки определенных размеров.
   * Рекомендуемые размеры по спецификации:
   * - 192x192 - минимальный для Android
   * - 512x512 - для больших экранов и Google Play
   * - Не менее 144 DPI для четкого отображения
   */

  "icons": [
    {
      "src": "/images/favicons/android-chrome-192x192.png",
      /*
       * Путь к файлу иконки:
       * - Должен быть абсолютным URL
       * - Может быть внешней ссылкой (CDN)
       * - Форматы: PNG, JPEG, SVG (не все браузеры поддерживают SVG)
       */

      "sizes": "192x192",
      /*
       * Размер иконки в пикселях:
       * - Указывается в формате "ширинаxвысота"
       * - Можно указать несколько через пробел: "192x192 512x512"
       * - Браузер выберет наиболее подходящий размер
       */

      "type": "image/png",
      /*
       * MIME-тип изображения:
       * - "image/png" для PNG
       * - "image/jpeg" для JPEG
       * - "image/svg+xml" для SVG
       */

      "purpose": "any maskable"
      /*
       * Назначение иконки (опционально):
       *
       * "any" - для любых целей (по умолчанию)
       * "maskable" - иконка может быть обрезана/маскирована
       *   (важно для Android adaptive icons)
       * "monochrome" - монохромная иконка
       * "badge" - для значков/бейджей
       *
       * Можно указать несколько через пробел: "any maskable"
       */
    },
    {
      "src": "/images/favicons/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
      /*
       * Большая иконка для:
       * - Google Play Store
       * - Больших экранов (планшеты, TV)
       * - Устройств с высоким DPI (Retina)
       */
    }
    /*
     * МОЖНО ДОБАВИТЬ ДОПОЛНИТЕЛЬНЫЕ ИКОНКИ:
     *
     * Для iOS (Apple требует отдельные иконки):
     * {
     *   "src": "/images/favicons/apple-touch-icon.png",
     *   "sizes": "180x180",
     *   "type": "image/png",
     *   "purpose": "any"
     * }
     *
     * Для Windows:
     * {
     *   "src": "/images/favicons/mstile-144x144.png",
     *   "sizes": "144x144",
     *   "type": "image/png"
     * }
     */
  ],

  /*
   * 5. ДОПОЛНИТЕЛЬНЫЕ ФУНКЦИИ (ОПЦИОНАЛЬНО)
   * ========================================================
   */

  /*
   * "splash_screen": {
   *   "image": "/images/splash-screen.png",
   *   "background_color": "#1d4ed8"
   * },
   * Загрузочный экран (сплэш-скрин):
   * - Показывается во время загрузки приложения
   * - Должен быть простым (логотип на фоне)
   * - Не все браузеры поддерживают
   */

  /*
   * "shortcuts": [
   *   {
   *     "name": "Наши проекты",
   *     "short_name": "Проекты",
   *     "description": "Посмотреть все проекты организации",
   *     "url": "/projects"
   *   }
   * ],
   * Быстрые действия (шорткаты):
   * - Появляются при долгом нажатии на иконку приложения
   * - Прямой доступ к важным разделам
   * - Поддерживается на Android и некоторых браузерах
   */

  /*
   * "categories": ["business", "education", "social"],
   * Категории приложения:
   * - Для магазинов приложений
   * - Помогает пользователям найти приложение
   * - Стандартные категории: https://github.com/w3c/manifest/wiki/Categories
   */

  /*
   * "prefer_related_applications": false,
   * Предпочитать ли связанные нативные приложения:
   * - true - предлагать установить нативное приложение если доступно
   * - false - всегда использовать веб-приложение (рекомендуется)
   */

  /*
   * "related_applications": [
   *   {
   *     "platform": "play",
   *     "id": "com.example.app",
   *     "url": "https://play.google.com/store/apps/details?id=com.example.app"
   *   }
   * ]
   * Связанные нативные приложения:
   * - Если у тебя есть отдельное Android/iOS приложение
   * - Браузер может предложить его установить
   */
}